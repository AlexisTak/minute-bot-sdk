{
  "name": "@la_minute_code/sdk",
  "version": "0.1.1",
  "description": "SDK public pour écrire des plugins Minute Bot.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "discord.js": "^14.27.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
